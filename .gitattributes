# Normalize line endings: LF in the repository, native on checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png  binary
*.jpg  binary
*.dds  binary
*.ktx2 binary
*.spv  binary
*.ttf  binary
*.otf  binary
*.wav  binary
*.ogg  binary
